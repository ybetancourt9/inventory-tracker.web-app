# Copy this file to .env at the repo root and fill in real values.
# Never commit .env.
#
# This single .env is read by:
#   - docker-compose.yml (variable interpolation)
#   - api/config/bootstrap.php (via phpdotenv)

# --- Application ---
APP_ENV=local
APP_DEBUG=true

# --- Web ---
# Host ports (bound to 127.0.0.1 only).
WEB_PORT=8080
CLIENT_PORT=4200

# --- Database (local: MySQL 8.0.46 in Docker; prod: AWS RDS MySQL) ---
# DB_HOST here is for HOST-side tools (a MySQL client, an IDE, doctrine run from
# the host). The api container overrides it to `db` in docker-compose.yml,
# because inside the compose network the database is reached by service name.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_tracker
DB_USER=inventory_app
DB_PASSWORD=change-me-local-only

# Used ONLY by docker-compose to initialize the MySQL container.
# Not consumed by the application at runtime.
DB_ROOT_PASSWORD=change-me-root-local-only

# Setting a CA turns on TLS to the database. Leave empty locally: the compose
# network is not encrypted and RDS is where this matters. In AWS point it at
# /etc/ssl/certs/rds-global-bundle.pem, which is baked into the api image.
DB_SSL_CA=

# Set to false ONLY when reaching RDS through the SSM tunnel, where the client
# dials localhost and no certificate names that host. Traffic stays encrypted.
DB_SSL_VERIFY=true

# Declared so DBAL does not open a connection purely to detect the platform.
DB_SERVER_VERSION=8.0.46

# --- Auth (JWT via firebase/php-jwt v7) ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ISSUER=inventory-tracker-api
JWT_TTL_SECONDS=3600
