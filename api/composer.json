{
    "name": "ybetancourt9/inventory-tracker-api",
    "description": "REST API for the Inventory Tracker web app (SNHU CS 499 capstone).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.2",
        "firebase/php-jwt": "^7.0",
        "luracast/restler": "^6.0",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "InventoryTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InventoryTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse",
        "check": [
            "@lint",
            "@analyze",
            "@test"
        ],
        "db:cli": "@php bin/doctrine",
        "db:migrate": "doctrine-migrations migrate --no-interaction",
        "db:diff": "doctrine-migrations diff",
        "db:status": "doctrine-migrations status"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
