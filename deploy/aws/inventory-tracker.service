[Unit]
Description=Inventory Tracker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/inventory-tracker

# Secrets are refetched on every start, so rotating a parameter takes effect
# with a restart and nothing stale survives on the instance.
ExecStartPre=/usr/local/bin/fetch-env
ExecStartPre=/usr/local/bin/ecr-login

# Two env files, because --env-file replaces compose's default .env lookup
# instead of adding to it. The first holds the registry and tag, the second the
# secrets; later files win.
ExecStart=/usr/bin/docker compose --env-file /opt/inventory-tracker/.env --env-file /run/inventory-tracker.env -f docker-compose.aws.yml up -d --pull always
ExecStop=/usr/bin/docker compose --env-file /opt/inventory-tracker/.env -f docker-compose.aws.yml down

# The env file is only needed while compose reads it.
ExecStartPost=/usr/bin/shred -u /run/inventory-tracker.env

TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
